{
  "name": "flagpole-api",
  "version": "0.3.0",
  "description": "Flagpole — a lightweight feature-flag service by Polaris Labs",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc",
